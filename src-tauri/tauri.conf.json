{
  "productName": "SyncUI",
  "version": "0.2.5",
  "identifier": "com.syncui.app",
  "mainBinaryName": "syncui",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SyncUI · 目录同步",
        "width": 1100,
        "height": 720,
        "minWidth": 820,
        "minHeight": 560,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {},
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "resources": [
      "resources/syncui-bridge.gz",
      "resources/agents/x86_64/syncui-agent.gz",
      "resources/agents/aarch64/syncui-agent.gz"
    ]
  }
}
